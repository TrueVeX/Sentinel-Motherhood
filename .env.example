# Copy the lines you need into .env.local (on your laptop) or into
# Vercel → Project → Settings → Environment Variables (online). Never share the real values.

# AI assistant (OpenRouter "sk-or-..." or NVIDIA "nvapi-..." key)
NVIDIA_API_KEY=
# Optional: choose a model
AI_MODEL=

# Database (set automatically when Upstash Redis is added through the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The site's public address, e.g. https://sentinel-motherhood.vercel.app (used for sign-in return links)
APP_URL=

# Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Live hospital phone numbers and opening hours from Google Maps (see GOOGLE-MAPS-SETUP.md).
# Both are needed: Google only allows its place data on a Google map.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_API_KEY=
